func _ready() -> void:
	# Erupt upwards animation from ground
	position.y -= 3.0
	var tween := create_tween()
	tween.tween_property(self, \"position:y\", 0.0, 0.4).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
"

